# PHPStan level 8, no baseline. szepeviktor/phpstan-wordpress is auto-included by phpstan/extension-installer.
parameters:
	level: 8
	phpVersion:
		min: 80100
		max: 80499
	paths:
		- pixalink-loyalty-for-woocommerce.php
		- uninstall.php
		- src
		- tests/e2e/mu-plugins
	bootstrapFiles:
		- tests/phpstan/bootstrap.php
	scanFiles:
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
	dynamicConstantNames:
		- PIXALINK_LOYALTY_DISTRIBUTION
		- PIXALINK_LOYALTY_VERSION
	# Filter return values come from third-party code: keep defensive checks on PHPDoc-typed values.
	treatPhpDocTypesAsCertain: false
	tmpDir: .phpstan-cache
