{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.pixalink.io/commerce/v1/event.request.json",
	"title": "POST events request: one lifecycle event envelope from the plugin outbox",
	"description": "id is a UUID v5 (Uuid::EVENT_NAMESPACE) and is also sent as X-Pixalink-Event-Id; exactly-once on (outlet, id). order.* data is a WooCommerce REST v3 subset.",
	"type": "object",
	"required": [ "id", "type", "version", "occurred_at", "sequence", "site_url", "outlet_id", "data" ],
	"additionalProperties": false,
	"properties": {
		"id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
		"type": { "enum": [ "order.paid", "order.completed", "order.cancelled", "order.refunded", "order.refund_deleted", "order.redemptions_released", "customer.upserted", "ping" ] },
		"version": { "const": 1 },
		"occurred_at": { "$ref": "common.json#/$defs/datetime" },
		"sequence": { "type": "integer", "minimum": 0, "description": "Per-order monotonically increasing; 0 for events without an order." },
		"site_url": { "$ref": "common.json#/$defs/url" },
		"outlet_id": { "$ref": "common.json#/$defs/id" },
		"data": { "type": "object" }
	},
	"allOf": [
		{
			"if": { "properties": { "type": { "enum": [ "order.paid", "order.completed" ] } } },
			"then": { "properties": { "data": { "$ref": "#/$defs/order_data" } } }
		},
		{
			"if": { "properties": { "type": { "const": "order.cancelled" } } },
			"then": { "properties": { "data": { "$ref": "#/$defs/cancel_data" } } }
		},
		{
			"if": { "properties": { "type": { "const": "order.refunded" } } },
			"then": { "properties": { "data": { "$ref": "#/$defs/refund_data" } } }
		},
		{
			"if": { "properties": { "type": { "enum": [ "order.refund_deleted", "order.redemptions_released" ] } } },
			"then": { "properties": { "data": { "$ref": "#/$defs/order_reference_data" } } }
		},
		{
			"if": { "properties": { "type": { "const": "customer.upserted" } } },
			"then": { "properties": { "data": { "$ref": "#/$defs/customer_upserted_data" } } }
		}
	],
	"$defs": {
		"customer_upserted_data": {
			"description": "customer.upserted: a logged-in shopper changed the phone number or marketing consent (My Account, registration, checkout), linked the account to Pixalink, or a guest placed an order with new consent. Random v4 id, sequence 0. Pixalink resolves the customer by pixalink_customer_id, then wp_user_id, then phone_e164; marketing_consent null leaves the status alone.",
			"type": "object",
			"required": [ "customer" ],
			"properties": {
				"customer": {
					"allOf": [ { "$ref": "#/$defs/customer" } ],
					"anyOf": [
						{ "properties": { "wp_user_id": { "type": "integer" } } },
						{ "properties": { "phone_e164": { "$ref": "common.json#/$defs/e164" } } }
					]
				}
			}
		},
		"customer": {
			"type": "object",
			"required": [ "wp_user_id", "is_guest", "phone_e164", "phone_country", "email", "first_name", "last_name", "marketing_consent" ],
			"properties": {
				"pixalink_customer_id": { "oneOf": [ { "$ref": "common.json#/$defs/id" }, { "type": "null" } ] },
				"wp_user_id": { "type": [ "integer", "null" ], "minimum": 1 },
				"is_guest": { "type": "boolean" },
				"phone_e164": { "oneOf": [ { "$ref": "common.json#/$defs/e164" }, { "type": "null" } ] },
				"phone_country": { "oneOf": [ { "$ref": "common.json#/$defs/country_code" }, { "type": "null" } ] },
				"email": { "oneOf": [ { "$ref": "common.json#/$defs/email" }, { "type": "null" } ] },
				"first_name": { "type": [ "string", "null" ] },
				"last_name": { "type": [ "string", "null" ] },
				"marketing_consent": { "oneOf": [ { "$ref": "common.json#/$defs/marketing_consent" }, { "type": "null" } ] }
			}
		},
		"line_item": {
			"type": "object",
			"required": [ "id", "product_id", "variation_id", "sku", "name", "quantity", "subtotal", "total", "total_tax" ],
			"properties": {
				"id": { "type": "integer", "minimum": 1 },
				"product_id": { "type": "integer", "minimum": 0 },
				"variation_id": { "type": "integer", "minimum": 0 },
				"sku": { "type": [ "string", "null" ] },
				"name": { "type": "string" },
				"category_slugs": { "type": "array", "items": { "type": "string" } },
				"category_names": { "type": "array", "items": { "type": "string" } },
				"quantity": { "type": "number" },
				"subtotal": { "$ref": "common.json#/$defs/decimal" },
				"total": { "$ref": "common.json#/$defs/decimal" },
				"total_tax": { "$ref": "common.json#/$defs/decimal" }
			}
		},
		"coupon_line": {
			"type": "object",
			"required": [ "code", "discount", "discount_tax", "meta" ],
			"properties": {
				"id": { "type": "integer", "minimum": 1 },
				"code": { "type": "string" },
				"discount": { "$ref": "common.json#/$defs/decimal" },
				"discount_tax": { "$ref": "common.json#/$defs/decimal" },
				"meta": {
					"type": "object",
					"properties": {
						"pixalink_kind": { "oneOf": [ { "$ref": "common.json#/$defs/redemption_kind" }, { "type": "null" } ] },
						"pixalink_redemption_id": { "oneOf": [ { "$ref": "common.json#/$defs/hold_ref" }, { "type": "null" } ] },
						"pixalink_voucher_id": { "oneOf": [ { "$ref": "common.json#/$defs/id" }, { "type": "null" } ] },
						"pixalink_points": { "type": [ "integer", "null" ], "minimum": 1 },
						"pixalink_amount_cents": { "description": "Value the store took off for this redemption, in cents: the discount, plus its tax share when prices include tax (for credits, the credits spent). Null for store coupons.", "type": [ "integer", "null" ], "minimum": 0 },
						"pixalink_coupon": { "oneOf": [ { "$ref": "#/$defs/coupon_snapshot" }, { "type": "null" } ] }
					}
				}
			}
		},
		"coupon_snapshot": {
			"description": "The resolved virtual coupon (_pixalink_coupon on the line): what WooCommerce applied, with local product and category ids.",
			"type": "object",
			"required": [ "discount_type", "amount" ],
			"properties": {
				"discount_type": { "enum": [ "fixed_cart", "percent", "fixed_product" ] },
				"amount": { "$ref": "common.json#/$defs/non_negative_decimal" },
				"product_ids": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
				"excluded_product_ids": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
				"product_categories": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
				"excluded_product_categories": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
				"limit_usage_to_x_items": { "type": [ "integer", "null" ], "minimum": 1 },
				"exclude_sale_items": { "type": "boolean" },
				"minimum_amount": { "type": "string" },
				"maximum_amount": { "type": "string" },
				"individual_use": { "type": "boolean" }
			}
		},
		"order": {
			"type": "object",
			"required": [ "id", "number", "order_key", "status", "currency", "date_created", "total", "total_tax", "shipping_total", "discount_total", "prices_include_tax", "line_items", "coupon_lines" ],
			"properties": {
				"id": { "type": "integer", "minimum": 1 },
				"number": { "type": "string", "minLength": 1 },
				"order_key": { "$ref": "common.json#/$defs/order_ref" },
				"status": { "type": "string" },
				"currency": { "$ref": "common.json#/$defs/currency" },
				"date_created": { "$ref": "common.json#/$defs/datetime" },
				"date_paid": { "$ref": "common.json#/$defs/nullable_datetime" },
				"date_completed": { "$ref": "common.json#/$defs/nullable_datetime" },
				"payment_method": { "type": [ "string", "null" ] },
				"created_via": { "type": [ "string", "null" ] },
				"total": { "$ref": "common.json#/$defs/decimal" },
				"total_tax": { "$ref": "common.json#/$defs/decimal" },
				"shipping_total": { "$ref": "common.json#/$defs/decimal" },
				"discount_total": { "$ref": "common.json#/$defs/decimal" },
				"prices_include_tax": { "description": "WooCommerce REST v3 prices_include_tax: whether the store entered its prices with tax when the order was placed. Amounts are sent as WooCommerce stores them either way: line subtotal and total exclude tax, total_tax carries it.", "type": "boolean" },
				"line_items": { "type": "array", "items": { "$ref": "#/$defs/line_item" } },
				"coupon_lines": { "type": "array", "items": { "$ref": "#/$defs/coupon_line" } }
			}
		},
		"order_reference": {
			"type": "object",
			"required": [ "id", "number", "order_key" ],
			"properties": {
				"id": { "type": "integer", "minimum": 1 },
				"number": { "type": "string", "minLength": 1 },
				"order_key": { "$ref": "common.json#/$defs/order_ref" }
			}
		},
		"order_data": {
			"type": "object",
			"required": [ "order", "customer" ],
			"properties": {
				"order": { "$ref": "#/$defs/order" },
				"customer": { "$ref": "#/$defs/customer" }
			}
		},
		"cancel_data": {
			"description": "order.cancelled: the full order payload plus whether it had been paid (holds and earn to reverse) and the status it was cancelled from.",
			"allOf": [ { "$ref": "#/$defs/order_data" } ],
			"properties": {
				"was_paid": { "type": "boolean" },
				"previous_status": { "type": "string" }
			}
		},
		"refund_data": {
			"description": "One order.refunded per WooCommerce refund id. Refund figures are unsigned amounts refunded (WooCommerce stores them negative); line_items is empty for an amount-only refund.",
			"type": "object",
			"required": [ "order", "customer", "refund" ],
			"properties": {
				"order": { "$ref": "#/$defs/order" },
				"customer": { "$ref": "#/$defs/customer" },
				"refund": {
					"type": "object",
					"required": [ "id", "amount", "reason", "created_at", "line_items" ],
					"properties": {
						"id": { "type": "integer", "minimum": 1 },
						"amount": { "$ref": "common.json#/$defs/non_negative_decimal" },
						"reason": { "type": [ "string", "null" ] },
						"created_at": { "$ref": "common.json#/$defs/datetime" },
						"shipping_total": { "$ref": "common.json#/$defs/decimal" },
						"line_items": {
							"type": "array",
							"items": {
								"type": "object",
								"required": [ "line_item_id", "quantity", "total" ],
								"properties": {
									"line_item_id": { "type": "integer", "minimum": 1 },
									"quantity": { "type": "number" },
									"total": { "$ref": "common.json#/$defs/decimal" }
								}
							}
						}
					}
				}
			}
		},
		"order_reference_data": {
			"description": "order.refund_deleted carries refund_id; order.redemptions_released carries reason: trashed | deleted (an unpaid order removed by the merchant; release every hold of the order) or payment_failed (with redemption_ids: release only those holds, so a release still in the outbox never undoes a hold placed on the same order since).",
			"type": "object",
			"required": [ "order" ],
			"properties": {
				"order": { "$ref": "#/$defs/order_reference" },
				"refund_id": { "type": "integer", "minimum": 1 },
				"reason": { "type": [ "string", "null" ] },
				"redemption_ids": { "type": "array", "items": { "$ref": "common.json#/$defs/hold_ref" }, "minItems": 1, "uniqueItems": true }
			}
		}
	},
