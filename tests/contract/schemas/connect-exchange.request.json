{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.pixalink.io/commerce/v1/connect-exchange.request.json",
	"title": "POST connect/exchange request (unauthenticated, unsigned)",
	"type": "object",
	"required": [ "code", "code_verifier", "site" ],
	"additionalProperties": false,
	"properties": {
		"code": { "type": "string", "minLength": 16, "maxLength": 128 },
		"code_verifier": { "type": "string", "pattern": "^[A-Za-z0-9._~-]{43,128}$" },
		"site": { "$ref": "common.json#/$defs/url" }
	},
	"examples": [
		{
			"code": "fake-code-0123456789abcdef0123456789abcdef01234567",
			"code_verifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk",
			"site": "https://shop.example.test"
		}
	]
}
