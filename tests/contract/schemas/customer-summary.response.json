{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.pixalink.io/commerce/v1/customer-summary.response.json",
	"title": "GET customers/{id} 200 response (My Account summary; 403 verification_required unless linked via otp/sso_ticket)",
	"type": "object",
	"required": [ "id", "linked_via", "balances", "tier", "vouchers", "memberships", "recent_activity", "qr", "portal_url" ],
	"properties": {
		"id": { "$ref": "common.json#/$defs/id" },
		"first_name": { "type": [ "string", "null" ] },
		"last_name": { "type": [ "string", "null" ] },
		"linked_via": { "$ref": "common.json#/$defs/linked_via" },
		"balances": {
			"type": "object",
			"required": [ "points", "credits", "currency" ],
			"properties": {
				"points": { "type": "integer", "minimum": 0 },
				"credits": { "$ref": "common.json#/$defs/non_negative_decimal" },
				"currency": { "$ref": "common.json#/$defs/currency" }
			}
		},
		"tier": {
			"oneOf": [
				{ "type": "null" },
				{
					"type": "object",
					"required": [ "name", "next_tier_name", "progress_percent" ],
					"properties": {
						"name": { "type": "string" },
						"next_tier_name": { "type": [ "string", "null" ] },
						"progress_percent": { "type": [ "integer", "null" ], "minimum": 0, "maximum": 100 },
						"spend_to_next": { "oneOf": [ { "$ref": "common.json#/$defs/non_negative_decimal" }, { "type": "null" } ] }
					}
				}
			]
		},
		"vouchers": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [ "id", "code", "title", "expires_at" ],
				"properties": {
					"id": { "$ref": "common.json#/$defs/id" },
					"code": { "type": "string" },
					"title": { "type": "string" },
					"description": { "type": [ "string", "null" ] },
					"image_url": { "oneOf": [ { "$ref": "common.json#/$defs/url" }, { "type": "null" } ] },
					"expires_at": { "$ref": "common.json#/$defs/nullable_datetime" },
					"redeemable_online": { "type": "boolean" }
				}
			}
		},
		"memberships": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [ "id", "name", "status", "expires_at" ],
				"properties": {
					"id": { "$ref": "common.json#/$defs/id" },
					"name": { "type": "string" },
					"status": { "enum": [ "active", "expired", "cancelled" ] },
					"expires_at": { "$ref": "common.json#/$defs/nullable_datetime" }
				}
			}
		},
		"recent_activity": {
			"type": "array",
			"maxItems": 50,
			"items": {
				"type": "object",
				"required": [ "type", "description", "occurred_at" ],
				"properties": {
					"type": { "enum": [ "points_earned", "points_redeemed", "points_expired", "points_adjusted", "voucher_issued", "voucher_used", "credit_topup", "credit_spent" ] },
					"description": { "type": "string" },
					"points": { "type": [ "integer", "null" ] },
					"amount": { "oneOf": [ { "$ref": "common.json#/$defs/decimal" }, { "type": "null" } ] },
					"occurred_at": { "$ref": "common.json#/$defs/datetime" }
				}
			}
		},
		"qr": {
			"type": "object",
			"required": [ "type", "value" ],
			"properties": {
				"type": { "const": "phone" },
				"value": { "type": "string", "minLength": 1 }
			}
		},
		"portal_url": { "$ref": "common.json#/$defs/url" }
	},
	"examples": [
		{
			"id": "5001",
			"first_name": "Aisyah",
			"last_name": "Rahman",
			"linked_via": "otp",
			"balances": { "points": 1250, "credits": "0.00", "currency": "MYR" },
			"tier": { "name": "Silver", "next_tier_name": "Gold", "progress_percent": 40, "spend_to_next": "300.00" },
			"vouchers": [ { "id": "88", "code": "PXL-WELCOME-88", "title": "RM10 off", "description": "Welcome voucher", "image_url": null, "expires_at": "2026-12-31T15:59:59Z", "redeemable_online": true } ],
			"memberships": [],
			"recent_activity": [ { "type": "points_earned", "description": "Order #1001", "points": 120, "amount": "120.00", "occurred_at": "2026-10-20T04:00:00Z" } ],
			"qr": { "type": "phone", "value": "60123456789" },
			"portal_url": "https://demo.pixalink.io/loyalty"
		}
	]
}
