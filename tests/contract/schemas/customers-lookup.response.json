{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.pixalink.io/commerce/v1/customers-lookup.response.json",
	"title": "GET customers 200 response (index-as-lookup; empty data = no member)",
	"type": "object",
	"required": [ "data" ],
	"properties": {
		"data": {
			"type": "array",
			"maxItems": 1,
			"items": { "$ref": "common.json#/$defs/customer_ref" }
		}
	},
	"examples": [
		{ "data": [ { "id": "5001", "first_name": "Aisyah", "last_name": "Rahman", "phone_e164": "+60123456789", "email": "member@example.com", "woocommerce_id": "17", "linked_via": "otp" } ] },
		{ "data": [] }
	]
}
